   <property name="styleSheet">
    <string notr="true">/* deep-green: #20251F - Fundo principal */
/* Paradise Green: #263326 - Fundo dos cartões */
/* dourado fosco: #B49A70 - Bordas de destaque e categorias */
/* Off-white: #F7F5EF - Títulos e botões principais */
/* bright-sand: #E8E0D2 - Textos secundários e hover */

QWidget#centralwidget {
    background-color: #20251F;
    color: #F7F5EF;
}

QFrame#frameFundoEscuro {
    background: transparent;
    border: none;
}

/* Cartões centrais em Paradise Green com borda dourada */
QFrame#cardConsulta, QFrame#cardLista {
    background-color: #263326;
    border: 1.5px solid #B49A70;
    border-radius: 15px;
}

/* Cartão inferior de sessão */
QFrame#frameSessao {
    background-color: #263326;
    border: 1px solid #3B543B;
    border-radius: 12px;
}

QLabel {
    background: transparent;
    border: none;
    color: #E8E0D2;
}

/* Rótulos de marca e categoria em dourado fosco */
QLabel#labelMarca {
    color: #B49A70;
    font-size: 13px;
    font-weight: bold;
}

QLabel#labelSistema {
    color: #E8E0D2;
    font-size: 12px;
}

QLabel#labelDestaque, QLabel#labelCategoriaConsulta, QLabel#labelCategoriaLista {
    color: #B49A70;
    font-size: 11px;
    font-weight: bold;
}

/* Títulos em Off-white */
QLabel#labelTitulo {
    color: #F7F5EF;
    font-size: 34px;
    font-weight: bold;
}

QLabel#labelConsultaTitulo, QLabel#labelListaTitulo {
    color: #F7F5EF;
    font-size: 21px;
    font-weight: bold;
}

QLabel#labelSessaoTitulo {
    color: #F7F5EF;
    font-size: 14px;
    font-weight: bold;
}

/* Descrições em Bright-sand */
QLabel#labelDescricao {
    color: #E8E0D2;
    font-size: 14px;
}

QLabel#labelConsultaDescricao, QLabel#labelListaDescricao, QLabel#labelSessaoDescricao {
    color: #E8E0D2;
    font-size: 13px;
}

/* Crachá do atendente */
QLabel#labelAtendente {
    color: #F7F5EF;
    background-color: #263326;
    border: 1.5px solid #B49A70;
    border-radius: 9px;
    font-size: 13px;
    font-weight: bold;
    padding: 10px 15px;
}

QLabel#labelRodape {
    color: #B49A70;
    font-size: 11px;
}

/* Botões principais invertidos */
QPushButton {
    border-radius: 10px;
    padding: 12px 18px;
    min-height: 30px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton#btnConsultarReserva, QPushButton#btnListarReservas {
    background-color: #F7F5EF;
    color: #20251F;
    border: 1.5px solid #B49A70;
}

QPushButton#btnConsultarReserva:hover, QPushButton#btnListarReservas:hover {
    background-color: #E8E0D2;
    color: #20251F;
    border: 1.5px solid #B49A70;
}

QPushButton#btnConsultarReserva:pressed, QPushButton#btnListarReservas:pressed {
    background-color: #B49A70;
    color: #20251F;
}

/* Botão Sair adaptado para fundo escuro */
QPushButton#btnSair {
    background-color: #20251F;
    color: #FCA5A5;
    border: 1px solid #991B1B;
}

QPushButton#btnSair:hover {
    background-color: #450A0A;
    color: #FEE2E2;
    border: 1px solid #EF4444;
}

QPushButton#btnSair:pressed {
    background-color: #7F1D1D;
    color: #FFFFFF;
}</string>
