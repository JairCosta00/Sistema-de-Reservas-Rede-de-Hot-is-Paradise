   <property name="styleSheet">
    <string>QWidget#centralwidget {
    background-color: #F6F8FC;
    color: #1F2937;
    font-family: &quot;Segoe UI&quot;;
}
QFrame#frameFundoEscuro { background: transparent; border: none; }
QFrame#cardConsulta, QFrame#cardLista {
    background-color: #FFFFFF;
    border: 1px solid #DFE5ED;
    border-radius: 15px;
}
QFrame#frameSessao {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
}
QLabel { background: transparent; border: none; color: #334155; }
QLabel#labelMarca { color: #AD7F35; font-size: 13px; font-weight: bold; }
QLabel#labelSistema { color: #64748B; font-size: 12px; }
QLabel#labelDestaque, QLabel#labelCategoriaConsulta, QLabel#labelCategoriaLista {
    color: #AD7F35; font-size: 11px; font-weight: bold;
}
QLabel#labelTitulo { color: #152238; font-size: 34px; font-weight: bold; }
QLabel#labelDescricao { color: #64748B; font-size: 14px; }
QLabel#labelAtendente {
    color: #1D4ED8; background-color: #EFF6FF;
    border: 1px solid #BFDBFE; border-radius: 9px;
    font-size: 13px; font-weight: bold; padding: 10px 15px;
}
QLabel#labelConsultaTitulo, QLabel#labelListaTitulo {
    color: #17243A; font-size: 21px; font-weight: bold;
}
QLabel#labelConsultaDescricao, QLabel#labelListaDescricao, QLabel#labelSessaoDescricao {
    color: #64748B; font-size: 13px;
}
QLabel#labelSessaoTitulo { color: #243247; font-size: 14px; font-weight: bold; }
QLabel#labelRodape { color: #94A3B8; font-size: 11px; }
QPushButton {
    border-radius: 10px;
    padding: 12px 18px;
    min-height: 30px;
    font-size: 13px;
    font-weight: bold;
}
QPushButton#btnConsultarReserva {
    background-color: #2563EB; color: white; border: 1px solid #2563EB;
}
QPushButton#btnConsultarReserva:hover { background-color: #1D4ED8; }
QPushButton#btnConsultarReserva:pressed { background-color: #1E40AF; }
QPushButton#btnListarReservas {
    background-color: #FFFFFF; color: #1D4ED8; border: 1px solid #93C5FD;
}
QPushButton#btnListarReservas:hover { background-color: #EFF6FF; }
QPushButton#btnListarReservas:pressed { background-color: #DBEAFE; }
QPushButton#btnSair {
    background-color: #FFFFFF; color: #B91C1C; border: 1px solid #FECACA;
}
QPushButton#btnSair:hover { background-color: #FEF2F2; border: 1px solid #EF4444; }
QPushButton#btnSair:pressed { background-color: #FEE2E2; }
</string>
