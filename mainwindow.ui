}

QPushButton#btnListarReservas:hover {
    background-color: rgba(255, 255, 255, 45);
}

/* Sair */
QPushButton#btnSair {
    background-color: rgba(127, 29, 29, 50);
    border: 1px solid #EF4444;
}

QPushButton#btnSair:hover {
    background-color: #DC2626;
}
