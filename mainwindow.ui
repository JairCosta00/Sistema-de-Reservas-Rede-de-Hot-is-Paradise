/* Configuração de todos os botões */
QPushButton {
    color: white;
    font-size: 14px;
    font-weight: bold;
    border-radius: 12px;
    padding: 0px 12px;
}

/* Consultar disponibilidade */
QPushButton#btnConsultarReserva {
