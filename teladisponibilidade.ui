  <property name="styleSheet">
   <string>QDialog#TelaDisponibilidade {
    background: #F5F7FB;
    font-family: &quot;Segoe UI&quot;;
    color: #14243D;
}
QFrame#cardHospedagem, QFrame#cardCliente, QFrame#cardAcoes {
    background: #FFFFFF;
    border: 1px solid #E1E7F0;
    border-radius: 14px;
}
QLabel {
    background: transparent;
    border: none;
    color: #334155;
    font-size: 13px;
}
QLabel#labelMarca {
    color: #AA7730;
    font-size: 13px;
    font-weight: bold;
}
QLabel#labelSobretitulo {
    color: #AA7730;
    font-size: 11px;
    font-weight: bold;
}
QLabel#labelTitulo {
    color: #122039;
    font-size: 31px;
    font-weight: bold;
}
QLabel#labelDescricao, QLabel#labelAjudaHospedagem, QLabel#labelAjudaCliente {
    color: #64748B;
    font-size: 13px;
}
QLabel#labelSecaoHospedagem, QLabel#labelSecaoCliente {
    color: #13243C;
    font-size: 19px;
    font-weight: bold;
}
QLabel#labelStatusTitulo {
    color: #13243C;
    font-size: 17px;
    font-weight: bold;
}
QLabel#labelDica {
    color: #64748B;
    background: #F1F5F9;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 11px 12px;
    font-size: 12px;
}
QLabel#labelResultado {
    color: #64748B;
    background: #F1F5F9;
    border: 1px solid #E2E8F0;
    border-radius: 9px;
    padding: 12px;
    font-size: 13px;
}
QLabel#labelRodape {
    color: #94A3B8;
    font-size: 11px;
}
QLineEdit, QComboBox, QDateEdit, QSpinBox {
    background: #FFFFFF;
    color: #15243A;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 9px 12px;
    min-height: 28px;
    font-size: 13px;
}
QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus {
    border: 1px solid #2563EB;
}
QComboBox QAbstractItemView {
    background: #FFFFFF;
    color: #15243A;
    selection-background-color: #DBEAFE;
}
QPushButton {
    min-height: 24px;
    border-radius: 9px;
    padding: 10px 18px;
    font-size: 13px;
    font-weight: bold;
}
QPushButton#btnVoltar {
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    color: #334155;
}
QPushButton#btnVoltar:hover { background: #F1F5F9; }
QPushButton#btnConsultar {
    background: #2563EB;
    color: #FFFFFF;
    border: 1px solid #2563EB;
}
QPushButton#btnConsultar:hover { background: #1D4ED8; }
QPushButton#btnRealizarReserva {
    background: #16834A;
    color: #FFFFFF;
    border: 1px solid #16834A;
}
QPushButton#btnRealizarReserva:hover { background: #166534; }
QPushButton#btnRealizarReserva:disabled {
    background: #E5E7EB;
    color: #64748B;
    border: 1px solid #D1D5DB;
}</string>
