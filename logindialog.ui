  <property name="styleSheet">
   <string notr="true">/* deep-green: #20251F - Bordas*/
/* dourado fosco: #B49A70 - Borda Destaque (contraste claro)*/
/* bright-sand: #E8E0D2 */
/* Off-white: #F7F5EF - Backgroud */
/* Paradise Green: #263326 - Destaques / Hover */

/* Fundo geral da janela */
QDialog#LoginDialog {
    background-color: #F1F5F9;
}

/* Cartão branco central */
QFrame#frameCard {
    background-color: #F7F5EF;
    border: 1px solid #20251F;
    border-radius: 14px;
    padding: 28px 32px;
}

/* Título do Hotel */
QLabel#labelTelaNomeHotel {
    background: transparent;
    border: none;
    margin-bottom: 6px;
}

/* Rótulos &quot;Login:&quot; e &quot;Senha:&quot; */
QLabel#labelLogin, QLabel#labelSenha {
    color: #475569;
    font-size: 13px;
    font-weight: 600;
    margin-top: 6px;
}

/* Campos de texto */
QLineEdit {
    min-height: 38px;
    padding: 0 12px;
    font-size: 14px;
    color: #1E293B;
    background-color: #F8FAFC;
    border: 1.5px solid #B49A70;	
    border-radius: 8px;
}

/* Destaque ao clicar para digitar */
QLineEdit:focus {
    background-color: #FFFFFF;
    border: 1.5px solid #263326;
}

/* Checkbox Mostrar Senha */
QCheckBox#checkBoxMostrarSenha {
    color: #475569;
    font-size: 13px;
    spacing: 8px;
    margin-top: 6px;
    margin-bottom: 12px;
}

/* Botão principal */
QPushButton#pushButtonEntrar {
    min-height: 42px;
    font-size: 14px;
    font-weight: bold;
    color: #F7F5EF;
    background-color: #263326;
    border: none;
    border-radius: 8px;
}

QPushButton#pushButtonEntrar:hover {
    background-color: #20251F;
}

QPushButton#pushButtonEntrar:pressed {
    background-color: #20251F;
}

/* Texto de versão no rodapé */
QLabel#labelTituloEVersao {
    color: #FFFFFF;
    background-color: rgba(15, 23, 42, 0.55);
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 11px;;
}

/* Subtítulo do formulário */
QLabel#labelInstrucao {
    color: #64748B;
    background: transparent;
    font-size: 12px;
    margin-bottom: 14px;
}

/* Aviso discreto abaixo do botão Entrar */
QLabel#labelMensagem {
    color: #B42318;
    background: transparent;
    border: none;
    font-size: 12px;
    font-weight: 600;
    padding-top: 5px;
}
</string>
