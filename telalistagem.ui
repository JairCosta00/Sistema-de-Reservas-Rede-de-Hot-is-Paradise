  <property name="styleSheet">
   <string notr="true">/* deep-green: #20251F - Fundo principal e linhas da tabela */
/* Paradise Green: #263326 - Cartão da tabela e linhas alternadas */
/* Green: #3B543B - Grades e botão confirmar pagamento */
/* dourado fosco: #B49A70 - Bordas de destaque, cabeçalho e seleção */
/* Off-white: #F7F5EF - Títulos, textos da tabela e botão atualizar */
/* bright-sand: #E8E0D2 - Descrições e hover */

QWidget#TelaListagem {
    background-color: #20251F;
    color: #F7F5EF;
}

QFrame#frameTabela {
    background-color: #263326;
    border: 1.5px solid #B49A70;
    border-radius: 15px;
}

QLabel {
    background: transparent;
    border: none;
    color: #E8E0D2;
}

QLabel#labelMarca {
    color: #B49A70;
    font-size: 13px;
    font-weight: bold;
}

QLabel#labelTitulo {
    color: #F7F5EF;
    font-size: 31px;
    font-weight: 700;
}

QLabel#labelDescricao {
    color: #E8E0D2;
    font-size: 13px;
}

/* Contador de reservas cadastradas */
QLabel#labelTotal {
    color: #F7F5EF;
    background-color: #20251F;
    border: 1px solid #B49A70;
    border-radius: 9px;
    padding: 9px 13px;
    font-size: 13px;
    font-weight: bold;
}

QLabel#labelVazio {
    color: #E8E0D2;
    font-size: 13px;
}

QLabel#labelRodape {
    color: #B49A70;
    font-size: 11px;
}

/* Botões */
QPushButton {
    border-radius: 9px;
    padding: 10px 18px;
    font-size: 13px;
    font-weight: bold;
    min-height: 20px;
}

QPushButton#btnVoltar {
    color: #F7F5EF;
    background-color: #263326;
    border: 1px solid #B49A70;
}
QPushButton#btnVoltar:hover {
    background-color: #3B543B;
}
QPushButton#btnVoltar:pressed {
    background-color: #20251F;
}

/* Botão confirmar pagamento (Green da paleta) */
QPushButton#btnConfirmarPagamento {
    color: #F7F5EF;
    background-color: #3B543B;
    border: 1.5px solid #B49A70;
}
QPushButton#btnConfirmarPagamento:hover {
    background-color: #496849;
}
QPushButton#btnConfirmarPagamento:pressed {
    background-color: #263326;
}
QPushButton#btnConfirmarPagamento:disabled {
    color: #6E776C;
    background-color: #20251F;
    border: 1px solid #3B543B;
}

/* Botão atualizar lista (Off-white invertido) */
QPushButton#btnAtualizar {
    color: #20251F;
    background-color: #F7F5EF;
    border: 1.5px solid #B49A70;
}
QPushButton#btnAtualizar:hover {
    background-color: #E8E0D2;
}
QPushButton#btnAtualizar:pressed {
    background-color: #B49A70;
    color: #20251F;
}

/* Tabela de reservas */
QTableWidget#tabelaReservas {
    background-color: #20251F;
    alternate-background-color: #263326;
    color: #F7F5EF;
    border: 1px solid #3B543B;
    border-radius: 8px;
    gridline-color: #3B543B;
    selection-background-color: #B49A70;
    selection-color: #20251F;
    font-size: 13px;
    outline: none;
}

QTableWidget#tabelaReservas::item {
    padding: 8px 6px;
    border-bottom: 1px solid #3B543B;
}

/* Mouse sobre uma reserva */
QTableWidget#tabelaReservas::item:hover {
    background-color: #3B543B;
    color: #F7F5EF;
}

/* Reserva selecionada: dourado claro */
QTableWidget#tabelaReservas::item:selected {
    background-color: #E8C99E;
    color: #20251F;
}

/* Mouse sobre a reserva selecionada */
QTableWidget#tabelaReservas::item:selected:hover {
    background-color: #A9B99D;
    color: #20251F;
}

QHeaderView::section {
    background-color: #20251F;
    color: #B49A70;
    border: none;
    border-bottom: 1.5px solid #B49A70;
    padding: 13px 9px;
    font-weight: bold;
    font-size: 12px;
}

QTableCornerButton::section {
    background-color: #20251F;
    border: none;
}</string>
