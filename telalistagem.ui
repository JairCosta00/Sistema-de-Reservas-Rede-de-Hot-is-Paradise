  <property name="styleSheet">
   <string>QWidget#TelaListagem {
    background-color: #F6F8FC;
    color: #1F2937;
    font-family: &quot;Segoe UI&quot;;
}
QFrame#frameTabela {
    background-color: #FFFFFF;
    border: 1px solid #DFE5ED;
    border-radius: 15px;
}
QLabel {
    background: transparent;
    border: none;
    color: #1F2937;
}
QLabel#labelMarca {
    color: #AD7F35;
    font-size: 13px;
    font-weight: bold;
}
QLabel#labelTitulo {
    color: #152238;
    font-size: 31px;
    font-weight: 700;
}
QLabel#labelDescricao {
    color: #64748B;
    font-size: 13px;
}
QLabel#labelTotal {
    color: #1D4ED8;
    background-color: #EFF6FF;
    border: 1px solid #BFDBFE;
    border-radius: 9px;
    padding: 9px 13px;
    font-size: 13px;
    font-weight: bold;
}
QLabel#labelVazio {
    color: #64748B;
    font-size: 13px;
}
QLabel#labelRodape {
    color: #94A3B8;
    font-size: 11px;
}
QPushButton {
    border-radius: 9px;
    padding: 10px 18px;
    font-size: 13px;
    font-weight: bold;
    min-height: 20px;
}
QPushButton#btnVoltar {
    color: #334155;
    background-color: #FFFFFF;
    border: 1px solid #CAD5E3;
}
QPushButton#btnVoltar:hover { background-color: #EDF2F7; }
QPushButton#btnVoltar:pressed { background-color: #E2E8F0; }
QPushButton#btnConfirmarPagamento {
    color: #FFFFFF;
    background-color: #15803D;
    border: 1px solid #15803D;
}
QPushButton#btnConfirmarPagamento:hover { background-color: #166534; }
QPushButton#btnConfirmarPagamento:disabled {
    color: #64748B;
    background-color: #E2E8F0;
    border: 1px solid #CBD5E1;
}
QPushButton#btnAtualizar {
    color: #FFFFFF;
    background-color: #2563EB;
    border: 1px solid #2563EB;
}
QPushButton#btnAtualizar:hover { background-color: #1D4ED8; }
QPushButton#btnAtualizar:pressed { background-color: #1E40AF; }
QTableWidget#tabelaReservas {
    background-color: #FFFFFF;
    alternate-background-color: #FAFCFF;
    color: #243247;
    border: 1px solid #DFE5ED;
    border-radius: 8px;
    gridline-color: #EDF2F7;
    selection-background-color: #DBEAFE;
    selection-color: #152238;
    font-size: 13px;
    outline: none;
}
QTableWidget#tabelaReservas::item {
    padding: 8px 6px;
    border-bottom: 1px solid #EDF2F7;
}
QTableWidget#tabelaReservas::item:hover { background-color: #EFF6FF; }
QHeaderView::section {
    background-color: #ECF1F7;
    color: #334155;
    border: none;
    border-bottom: 1px solid #D9E1EC;
    padding: 13px 9px;
    font-weight: bold;
    font-size: 12px;
}
QTableCornerButton::section { background-color: #ECF1F7; border: none; }
</string>
