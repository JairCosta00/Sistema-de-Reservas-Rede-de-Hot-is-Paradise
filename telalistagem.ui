  <property name="styleSheet">
   <string>QWidget#TelaListagem { background-color: #F8FAFC; }
QFrame#frameTabela { background-color: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 14px; }
QLabel { background: transparent; border: none; color: #1F2937; }
QLabel#labelMarca { color: #B8863B; font-size: 12px; font-weight: bold; }
QLabel#labelTitulo { color: #111827; font-size: 30px; font-weight: bold; }
QLabel#labelDescricao { color: #64748B; font-size: 13px; }
QLabel#labelTotal { color: #334155; font-size: 15px; font-weight: bold; }
QLabel#labelVazio { color: #94A3B8; font-size: 13px; }
QLabel#labelRodape { color: #94A3B8; font-size: 11px; }
QPushButton { font-size: 13px; font-weight: bold; border-radius: 9px; padding: 10px 18px; }
QPushButton#btnVoltar { color: #334155; background: #FFFFFF; border: 1px solid #CBD5E1; }
QPushButton#btnVoltar:hover { background: #F1F5F9; }
QPushButton#btnAtualizar { color: #FFFFFF; background: #2563EB; border: 1px solid #2563EB; }
QPushButton#btnAtualizar:hover { background: #1D4ED8; }
QTableWidget#tabelaReservas { background-color: #FFFFFF; alternate-background-color: #F8FAFC; color: #1F2937; border: none; selection-background-color: #DBEAFE; selection-color: #1E3A8A; font-size: 12px; }
QHeaderView::section { background: #F1F5F9; color: #475569; border: none; border-bottom: 1px solid #E2E8F0; padding: 10px; font-size: 12px; font-weight: bold; }
QTableCornerButton::section { background: #F1F5F9; border: none; }
</string>
